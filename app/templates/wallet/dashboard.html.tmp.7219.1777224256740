{% extends 'base.html' %}
{% block title %}Mi monedero — Padel BCV{% endblock %}

{% block content %}
<h5 class="fw-bold mb-3"><i class="bi bi-wallet2 me-2 text-primary"></i>Mi monedero</h5>

{# ── Balance card ──────────────────────────────────────────────── #}
<div class="balance-card mb-4">
  <div class="balance-label">Saldo disponible</div>
  <div class="balance-amount">{{ '%.2f'|format(current_user.wallet_balance) }}€</div>
  <div class="mt-2">
    <a href="{{ url_for('wallet.payment_qr') }}" class="btn btn-light btn-sm">
      <i class="bi bi-qr-code me-1"></i>Ver datos de pago
    </a>
  </div>
</div>

{# ── Transactions ──────────────────────────────────────────────── #}
<h6 class="fw-semibold mb-2">Historial de movimientos</h6>

{% if transactions %}
<div class="card border-0 shadow-sm">
  <ul class="list-group list-group-flush">
    {% for tx in transactions %}
    <li class="list-group-item py-2 px-3">
      <div class="d-flex align-items-center gap-2">
        <div class="tx-icon
             {{ 'tx-credit' if tx.amount > 0 else 'tx-debit' }}">
          {% if tx.amount > 0 %}
            <i class="bi bi-arrow-down-circle-fill"></i>
          {% else %}
            <i class="bi bi-arrow-up-circle-fill"></i>
          {% endif %}
        </div>
        <div class="flex-grow-1 overflow-hidden">
          <div class="small fw-semibold text-truncate">{{ tx.description }}</div>
          <div class="text-muted" style="font-size:.7rem">
            {{ tx.created_at.strftime('%d/%m/%Y %H:%M') }}
          </div>
        </div>
        <div class="fw-bold flex-shrink-0
             {{ 'text-success' if tx.amount > 0 else 'text-danger' }}">
          {{ '+' if tx.amount > 0 else '' }}{{ '%.2f'|format(tx.amount) }}€
        </div>
      </div>
    </li>
    {% endfor %}
  </ul>
</div>
{% else %}
<div class="text-center py-5 text-muted">
  <i class="bi bi-receipt" style="font-size:2.5rem"></i>
  <p class="mt-2 small">No hay movimientos registrados.</p>
</div>
{% endif %}
{% endblock %}
