{% extends 'base.html' %}
{% block title %}Jugadores — Padel BCV{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-2 mb-3">
  <a href="{{ url_for('admin.dashboard') }}" class="btn btn-sm btn-outline-secondary">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h5 class="mb-0 fw-bold">
    <i class="bi bi-people-fill me-1 text-primary"></i>Jugadores
    <span class="badge bg-secondary ms-1">{{ players|length }}</span>
  </h5>
</div>

{% if players %}
{% for player in players %}
<div class="card border-0 shadow-sm mb-2">
  <div class="card-body py-3 px-3">
    <div class="d-flex align-items-start gap-3">
      <div class="avatar-circle avatar-lg flex-shrink-0">{{ player.username[0].upper() }}</div>
      <div class="flex-grow-1 overflow-hidden">
        <div class="fw-semibold text-truncate">{{ player.username }}</div>
        <div class="text-muted small text-truncate">{{ player.email }}</div>
        <div class="d-flex gap-2 mt-1 flex-wrap">
          <span class="badge skill-badge skill-{{ player.skill_category_key }}">
            {{ player.skill_label }} ({{ '%.1f'|format(player.skill_level) }})
          </span>
          <span class="badge bg-light text-dark border">
            <i class="bi bi-wallet2 me-1 text-success"></i>{{ '%.2f'|format(player.wallet_balance) }}€
          </span>
        </div>
      </div>
    </div>

    {# Add balance form #}
    <form method="POST"
          action="{{ url_for('admin.add_balance', player_id=player.id) }}"
          class="mt-3 d-flex gap-2 align-items-center">
      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
      <div class="input-group input-group-sm">
        <input type="number" name="amount" class="form-control"
               placeholder="Importe €" min="0.50" step="0.50" required>
        <span class="input-group-text">€</span>
      </div>
      <button class="btn btn-success btn-sm flex-shrink-0">
        <i class="bi bi-plus-circle me-1"></i>Recargar
      </button>
    </form>

  </div>
</div>
{% endfor %}
{% else %}
<div class="text-center py-5 text-muted">
  <i class="bi bi-person-x" style="font-size:2.5rem"></i>
  <p class="mt-2">No hay jugadores registrados.</p>
</div>
{% endif %}
{% endblock %}
