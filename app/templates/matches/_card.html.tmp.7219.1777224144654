{% set pct = (match.player_count / 4 * 100)|int %}
<div class="card match-card shadow-sm mb-3 border-0">
  <div class="card-body py-3 px-3">

    <div class="d-flex justify-content-between align-items-start mb-1">
      <div class="fw-semibold text-truncate me-2" style="max-width:68%">
        <i class="bi bi-geo-alt-fill text-primary me-1"></i>{{ match.location }}
      </div>
      <span class="badge skill-badge skill-{{ match.required_skill }}">{{ match.required_skill_label }}</span>
    </div>

    <div class="text-muted small mb-2">
      <i class="bi bi-calendar3 me-1"></i>{{ match.date.strftime('%a %d/%m/%Y') }}
      &nbsp;·&nbsp;
      <i class="bi bi-clock me-1"></i>{{ match.start_time.strftime('%H:%M') }}–{{ match.end_time.strftime('%H:%M') }}
    </div>

    <div class="d-flex align-items-center gap-3 mb-3">
      <div class="d-flex align-items-center gap-2 flex-grow-1">
        <i class="bi bi-people-fill text-muted" style="font-size:.9rem"></i>
        <span class="small fw-semibold">{{ match.player_count }}/4</span>
        <div class="player-bar flex-grow-1">
          <div class="player-bar-fill" style="width:{{ pct }}%"></div>
        </div>
      </div>
      <span class="small text-muted">
        <i class="bi bi-currency-euro"></i>{{ '%.2f'|format(match.price_per_player) }}
      </span>
    </div>

    <div class="d-flex gap-2">
      {% if current_user.is_admin %}
      <a href="{{ url_for('admin.manage_match', match_id=match.id) }}"
         class="btn btn-outline-primary btn-sm flex-fill">
        <i class="bi bi-gear me-1"></i>Gestionar
      </a>
      {% else %}
      <a href="{{ url_for('matches.match_detail', match_id=match.id) }}"
         class="btn btn-outline-primary btn-sm flex-fill">
        <i class="bi bi-eye me-1"></i>Ver detalle
      </a>
      {% endif %}

      <span class="badge status-badge status-{{ match.status }} align-self-center ms-auto">
        {% if match.status == 'open' %}Abierto
        {% elif match.status == 'confirmed' %}Confirmado
        {% elif match.status == 'cancelled' %}Cancelado
        {% else %}Completado{% endif %}
      </span>
    </div>

  </div>
</div>
