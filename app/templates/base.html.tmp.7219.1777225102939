<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Padel BCV{% endblock %}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top" id="mainNav">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold" href="{{ url_for('index') }}">
      <i class="bi bi-trophy-fill me-1"></i>Padel BCV
    </a>
    <button class="navbar-toggler border-0" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarMenu"
            aria-controls="navbarMenu" aria-expanded="false">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMenu">
      {% if current_user.is_authenticated %}
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link {% if request.endpoint and request.endpoint.startswith('matches') %}active{% endif %}"
             href="{{ url_for('matches.list_matches') }}">
            <i class="bi bi-calendar-event me-1"></i>Matchs
          </a>
        </li>
        {% if current_user.is_admin %}
        <li class="nav-item">
          <a class="nav-link {% if request.endpoint and request.endpoint.startswith('admin') %}active{% endif %}"
             href="{{ url_for('admin.dashboard') }}">
            <i class="bi bi-speedometer2 me-1"></i>Administration
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ url_for('admin.list_players') }}">
            <i class="bi bi-people-fill me-1"></i>Joueurs
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ url_for('admin.create_match') }}">
            <i class="bi bi-plus-circle-fill me-1"></i>Nouveau match
          </a>
        </li>
        {% else %}
        <li class="nav-item">
          <a class="nav-link {% if request.endpoint and request.endpoint.startswith('wallet') %}active{% endif %}"
             href="{{ url_for('wallet.dashboard') }}">
            <i class="bi bi-wallet2 me-1"></i>Portefeuille
            <span class="badge bg-success ms-1">{{ '%.2f'|format(current_user.wallet_balance) }}€</span>
          </a>
        </li>
        {% endif %}
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i>{{ current_user.username }}
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            {% if not current_user.is_admin %}
            <li>
              <span class="dropdown-item-text text-muted small">
                <i class="bi bi-bar-chart-fill me-1 text-primary"></i>
                Niveau : <strong>{{ current_user.skill_label }}</strong>
                ({{ '%.1f'|format(current_user.skill_level) }})
              </span>
            </li>
            <li><hr class="dropdown-divider"></li>
            {% endif %}
            <li>
              <a class="dropdown-item text-danger" href="{{ url_for('auth.logout') }}">
                <i class="bi bi-box-arrow-right me-1"></i>Se déconnecter
              </a>
            </li>
          </ul>
        </li>
      </ul>
      {% else %}
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="{{ url_for('auth.login') }}">Se connecter</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ url_for('auth.register') }}">S'inscrire</a>
        </li>
      </ul>
      {% endif %}
    </div>
  </div>
</nav>

<main class="container-fluid px-3 py-3" style="max-width:640px">

  {% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
  <div class="flash-container">
    {% for category, message in messages %}
    <div class="alert alert-{{ category }} alert-dismissible fade show py-2 small" role="alert">
      {{ message }}
      <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endwith %}

  {% block content %}{% endblock %}
</main>

<footer class="text-center py-3 mt-2 text-muted small border-top">
  <i class="bi bi-trophy-fill me-1 text-primary"></i>Padel BCV &copy; 2024
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch(e) {}
    });
  }, 5000);
</script>
{% block scripts %}{% endblock %}
</body>
</html>
