{% extends 'base.html' %}
{% block title %}Connexion — Padel BCV{% endblock %}

{% block content %}
<div class="row justify-content-center mt-3">
  <div class="col-12 col-sm-9">

    <div class="text-center mb-4">
      <div class="brand-icon mb-2">
        <i class="bi bi-trophy-fill text-primary" style="font-size:3rem"></i>
      </div>
      <h4 class="fw-bold">Padel BCV</h4>
      <p class="text-muted small">Association de Padel</p>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h5 class="card-title mb-4 text-center">Se connecter</h5>
        <form method="POST" novalidate>
          {{ form.hidden_tag() }}

          <div class="mb-3">
            {{ form.email.label(class="form-label fw-semibold small") }}
            {{ form.email(class="form-control" + (" is-invalid" if form.email.errors else ""),
                          placeholder="votre@email.com", autocomplete="email") }}
            {% for e in form.email.errors %}
            <div class="invalid-feedback">{{ e }}</div>
            {% endfor %}
          </div>

          <div class="mb-3">
            {{ form.password.label(class="form-label fw-semibold small") }}
            {{ form.password(class="form-control" + (" is-invalid" if form.password.errors else ""),
                             placeholder="Mot de passe", autocomplete="current-password") }}
            {% for e in form.password.errors %}
            <div class="invalid-feedback">{{ e }}</div>
            {% endfor %}
          </div>

          <div class="mb-4 form-check">
            {{ form.remember_me(class="form-check-input") }}
            {{ form.remember_me.label(class="form-check-label small") }}
          </div>

          <div class="d-grid">
            {{ form.submit(class="btn btn-primary btn-lg fw-semibold") }}
          </div>
        </form>
      </div>
    </div>

    <p class="text-center mt-3 small text-muted">
      Pas encore de compte ?
      <a href="{{ url_for('auth.register') }}" class="fw-semibold">S'inscrire ici</a>
    </p>

  </div>
</div>
{% endblock %}
