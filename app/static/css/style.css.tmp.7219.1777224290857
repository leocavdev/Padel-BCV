/* ── Design tokens ──────────────────────────────────────────────── */
:root {
  --green-dark:  #1b4332;
  --green-main:  #2d6a4f;
  --green-light: #52b788;
  --orange:      #f4a261;
  --bg:          #f4f6f4;
}

body {
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ── Navbar ─────────────────────────────────────────────────────── */
#mainNav {
  background-color: var(--green-main) !important;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
}

/* ── Bootstrap overrides ────────────────────────────────────────── */
.btn-primary       { background-color: var(--green-main); border-color: var(--green-main); }
.btn-primary:hover { background-color: var(--green-dark);  border-color: var(--green-dark); }
.btn-primary:focus { background-color: var(--green-dark);  border-color: var(--green-dark); box-shadow: 0 0 0 .2rem rgba(45,106,79,.4); }

.text-primary { color: var(--green-main) !important; }
.bg-primary   { background-color: var(--green-main) !important; }

.btn-outline-primary        { border-color: var(--green-main); color: var(--green-main); }
.btn-outline-primary:hover  { background-color: var(--green-main); border-color: var(--green-main); }

/* ── Match card ─────────────────────────────────────────────────── */
.match-card {
  border-left: 4px solid var(--green-main) !important;
  transition: transform .15s, box-shadow .15s;
}
.match-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0,0,0,.1) !important;
}

/* ── Player bar ─────────────────────────────────────────────────── */
.player-bar {
  height: 6px;
  border-radius: 3px;
  background: #dee2e6;
  overflow: hidden;
}
.player-bar-fill {
  height: 100%;
  background: var(--green-light);
  border-radius: 3px;
  transition: width .3s;
}

/* ── Skill badges ───────────────────────────────────────────────── */
.skill-badge          { font-size: .68rem; font-weight: 600; }
.skill-beginner       { background-color: #6c757d !important; color: #fff; }
.skill-intermediate   { background-color: #0d6efd !important; color: #fff; }
.skill-advanced       { background-color: #fd7e14 !important; color: #fff; }
.skill-expert         { background-color: #dc3545 !important; color: #fff; }

/* ── Status badges ──────────────────────────────────────────────── */
.status-badge    { font-size: .68rem; font-weight: 600; }
.status-open     { background-color: #d1e7dd; color: #0f5132; }
.status-confirmed{ background-color: #cfe2ff; color: #084298; }
.status-cancelled{ background-color: #f8d7da; color: #842029; }
.status-completed{ background-color: #e2e3e5; color: #383d41; }

/* ── Payment badges ─────────────────────────────────────────────── */
.pay-badge       { font-size: .65rem; }
.pay-paid        { background-color: #d1e7dd; color: #0f5132; }
.pay-pending     { background-color: #fff3cd; color: #664d03; }
.pay-refunded    { background-color: #cfe2ff; color: #084298; }

/* ── Avatar circle ──────────────────────────────────────────────── */
.avatar-circle {
  width: 34px; height: 34px;
  border-radius: 50%;
  background-color: var(--green-main);
  color: #fff;
  font-weight: 700;
  font-size: .85rem;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.avatar-lg { width: 42px; height: 42px; font-size: 1rem; }

/* ── Balance card ───────────────────────────────────────────────── */
.balance-card {
  background: linear-gradient(135deg, var(--green-main), var(--green-light));
  border-radius: 16px;
  color: #fff;
  padding: 28px 24px;
  text-align: center;
  box-shadow: 0 4px 16px rgba(45,106,79,.3);
}
.balance-label  { font-size: .85rem; opacity: .85; }
.balance-amount { font-size: 3rem; font-weight: 800; line-height: 1.1; }

/* ── Transaction icons ──────────────────────────────────────────── */
.tx-icon        { font-size: 1.4rem; }
.tx-credit      { color: #198754; }
.tx-debit       { color: #dc3545; }

/* ── QR box ─────────────────────────────────────────────────────── */
.qr-box {
  display: inline-block;
  border: 2px dashed var(--green-main);
  border-radius: 12px;
  padding: 12px;
  background: #fff;
}

/* ── Stat cards ─────────────────────────────────────────────────── */
.stat-card {
  border-radius: 12px;
  padding: 16px 12px;
  text-align: center;
  color: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.12);
}
.stat-number { font-size: 2.2rem; font-weight: 800; line-height: 1; }
.stat-label  { font-size: .72rem; opacity: .85; margin-top: 2px; }

/* ── Section labels ─────────────────────────────────────────────── */
.section-label {
  text-transform: uppercase;
  font-size: .7rem;
  letter-spacing: .06em;
  color: #6c757d;
  font-weight: 600;
  margin-bottom: .5rem;
}

/* ── Info items (match detail) ──────────────────────────────────── */
.info-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: .9rem;
}
.info-item i { font-size: 1rem; margin-top: 2px; flex-shrink: 0; }
.info-label  { font-size: .68rem; text-transform: uppercase; color: #6c757d; letter-spacing: .04em; }
.info-value  { font-size: .9rem; font-weight: 600; }

/* ── Responsive container ───────────────────────────────────────── */
@media (max-width: 480px) {
  .balance-amount { font-size: 2.4rem; }
}
